  "exclusions": [
    {
      "pattern": "entities/*.md",
      "reason": "Declaration catalogs support local code navigation; public topics bind selected evidence explicitly."
    },
    {
      "pattern": "modules/*.md",
      "reason": "Internal module catalogs support code navigation. Public topics bind their owning contracts and implementation files directly."
    },
    {
      "pattern": "workflows/*.md",
      "reason": "Internal workflow details stay local unless a public topic explicitly depends on them."
    },
    {
      "pattern": "infrastructure/*.md",
      "reason": "Internal infrastructure inventories stay local."
    },
    {
      "pattern": "guides/*.md",
      "reason": "Architecture reading guides remain local; user documentation dependencies are mapped deliberately."
    },
    {
      "pattern": "flows/api-*.md",
      "reason": "Public API and protocol topics bind their documented interfaces directly."
    },
    {
      "pattern": "flows/process-*.md",
      "reason": "Internal process catalogs stay local."
    },
    {
      "pattern": "flows/http-*.md",
      "reason": "Internal HTTP flow catalogs stay local."
    },
    {
      "pattern": "index.md",
      "reason": "Native navigation is maintained locally and is not a public topic claim."
    },
    {
      "pattern": "load-order.md",
      "reason": "Native reading order supports local navigation."
    },
    {
      "pattern": "log.md",
      "reason": "Native operational history remains local."
    },
    {
      "pattern": "dependencies.md",
      "reason": "Public installation requirements bind package and toolchain declarations directly."
    },
    {
      "pattern": "api-contracts.md",
      "reason": "The internal API catalog supports local implementation discovery."
    }
  ],
  "reference_providers": {
    "llm-wiki": {
      "kind": "llm-wiki-cli"
    },
    "provider-policy": {
      "kind": "llm-wiki-behavior"
    }
  },
  "content": {
    "root": "docs",
    "repository_url": "https://github.com/Denissvgn/python-wiki-llm"
  }
}
