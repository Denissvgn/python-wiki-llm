{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-wiki:maintenance-binding-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adoption_id",
    "state_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "llm-wiki-maintenance-binding/v1"
    },
    "adoption_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
