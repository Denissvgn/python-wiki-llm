{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.invalid/schemas/llm-wiki-engine-event-v1.schema.json",
  "title": "Event an embedded engine reports to its host",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "llm-wiki-engine-event/v1"
    },
    "kind": {
      "enum": [
        "operation.started",
        "message",
        "operation.finished",
        "operation.failed"
      ]
    },
    "operation": {
      "$ref": "#/$defs/text"
    },
    "operation_id": {
      "$ref": "#/$defs/text"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "operation",
    "operation_id",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "operation.started"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "source_root": {
                "$ref": "#/$defs/text"
              },
              "wiki_root": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "message"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "stream": {
                "enum": [
                  "stdout",
                  "stderr"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "stream",
              "text"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "operation.finished"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "result": {
                "type": "object"
              }
            },
            "required": [
              "result"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "operation.failed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "error": {
                "$ref": "#/$defs/text"
              },
              "message": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              }
            },
            "required": [
              "error",
              "message"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
