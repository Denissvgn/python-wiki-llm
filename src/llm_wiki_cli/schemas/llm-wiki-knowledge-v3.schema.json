{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-wiki:schema:knowledge:v3",
  "title": "Indexed packed knowledge root v3",
  "description": "Explicit physical packing of unchanged v2 logical objects. Selected member validation and complete archive validation remain distinct.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "llm-wiki-knowledge/v3"
    },
    "store": {
      "$ref": "urn:llm-wiki:schema:knowledge:v2"
    },
    "packing": {
      "type": "object",
      "properties": {
        "compression": {
          "enum": [
            "stored",
            "deflate"
          ]
        },
        "catalog": {
          "$ref": "urn:llm-wiki:schema:knowledge-pack-index:v1#/$defs/descriptor"
        },
        "objects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "packs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "pack_catalog": {
          "$ref": "urn:llm-wiki:schema:knowledge-pack-index:v1#/$defs/descriptor"
        }
      },
      "required": [
        "compression",
        "catalog",
        "objects",
        "packs",
        "pack_catalog"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "store",
    "packing"
  ],
  "additionalProperties": false
}
