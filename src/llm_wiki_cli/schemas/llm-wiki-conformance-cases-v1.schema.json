{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.invalid/schemas/llm-wiki-conformance-cases-v1.schema.json",
  "title": "Shared conformance cases for one published format",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "llm-wiki-conformance-cases/v1"
    },
    "format": {
      "type": "string",
      "pattern": "^llm-wiki-[a-z0-9-]+/v[1-9][0-9]*$"
    },
    "schema": {
      "type": "string",
      "pattern": "^llm-wiki-[a-z0-9-]+-v[1-9][0-9]*\\.schema\\.json$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "valid": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "document": true
        },
        "required": [
          "document",
          "name",
          "valid"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "schema",
    "cases"
  ],
  "additionalProperties": false
}
