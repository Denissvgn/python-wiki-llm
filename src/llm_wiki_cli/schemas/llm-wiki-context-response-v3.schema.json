{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.invalid/schemas/llm-wiki-context-response-v3.schema.json",
  "title": "Budgeted context response",
  "description": "A response to an llm-wiki-context/v3 request: a budgeted context envelope whose accounting covers the complete emitted text, an invalid-request envelope, or a cannot-fit refusal. JSON and packet output is this document followed by a newline; Markdown output carries it as the first fenced JSON block. A response is valid only if it also passes checks a JSON Schema cannot express: used_tokens must not exceed budget_tokens (and must exceed it in a refusal), the embedded context or packet must pass its own format checks, change paths must be portable, sorted and hashed into paths_id, and refusal counts must agree. Binding request_id to a request and recounting the emitted text need the request and the named counter. A failure to provide required knowledge is reported with the llm-wiki-context/v2 error envelope. Conformance cases with schema_valid true and valid false exercise those checks.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "llm-wiki-context/v3"
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "protocol"
  ],
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "$ref": "#/$defs/success"
  },
  "else": {
    "$ref": "#/$defs/error"
  },
  "$defs": {
    "accounting": {
      "type": "object",
      "properties": {
        "budget_tokens": {
          "$ref": "#/$defs/count"
        },
        "used_tokens": {
          "$ref": "#/$defs/count"
        },
        "counter_id": {
          "$ref": "#/$defs/text"
        },
        "mode": {
          "enum": [
            "exact",
            "estimated"
          ]
        },
        "exact_compliance": {
          "type": "boolean"
        },
        "usage_kind": {
          "const": "upper-bound-including-accounting"
        },
        "scope": {
          "const": "emitted-text-without-host-chat-framing"
        }
      },
      "required": [
        "budget_tokens",
        "counter_id",
        "exact_compliance",
        "mode",
        "scope",
        "usage_kind",
        "used_tokens"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "mode": {
            "const": "estimated"
          }
        }
      },
      "then": {
        "properties": {
          "exact_compliance": {
            "const": false
          }
        }
      }
    },
    "cannot_fit": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "llm-wiki-context/v3"
        },
        "ok": {
          "const": false
        },
        "error": {
          "const": "cannot-fit"
        },
        "accounting": {
          "allOf": [
            {
              "$ref": "#/$defs/accounting"
            },
            {
              "properties": {
                "exact_compliance": {
                  "const": false
                }
              }
            }
          ]
        },
        "diagnostics": {
          "$ref": "#/$defs/refusal"
        }
      },
      "required": [
        "accounting",
        "diagnostics",
        "error",
        "ok",
        "protocol"
      ],
      "additionalProperties": false
    },
    "changes": {
      "description": "The change selection: the legacy last-commit default, or explicit paths, a Git range or the staged index with their resolved identities.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "legacy-last-commit"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "request"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "request": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "paths"
                    },
                    "paths": {
                      "$ref": "#/$defs/source_paths"
                    }
                  },
                  "required": [
                    "mode",
                    "paths"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "range"
                    },
                    "base": {
                      "$ref": "#/$defs/revision"
                    },
                    "head": {
                      "$ref": "#/$defs/revision"
                    },
                    "commits": {
                      "type": "object",
                      "properties": {
                        "base": {
                          "$ref": "#/$defs/commit_id"
                        },
                        "head": {
                          "$ref": "#/$defs/commit_id"
                        }
                      },
                      "required": [
                        "base",
                        "head"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "base",
                    "commits",
                    "head",
                    "mode"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "staged"
                    },
                    "index_id": {
                      "$ref": "#/$defs/sha256"
                    }
                  },
                  "required": [
                    "index_id",
                    "mode"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "paths": {
              "$ref": "#/$defs/source_paths"
            },
            "path_basis": {
              "const": "source-root"
            },
            "selection_boundary_changed": {
              "type": "boolean"
            },
            "paths_id": {
              "$ref": "#/$defs/sha256"
            },
            "affected_pages": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/page_path"
                },
                "uniqueItems": true
              }
            }
          },
          "required": [
            "affected_pages",
            "path_basis",
            "paths",
            "paths_id",
            "request",
            "selection_boundary_changed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "collection_bound": {
      "type": "object",
      "properties": {
        "total": {
          "$ref": "#/$defs/count"
        },
        "returned": {
          "$ref": "#/$defs/count"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "returned",
        "total",
        "truncated"
      ],
      "additionalProperties": false
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "context_v2": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "llm-wiki-context/v2"
        },
        "ok": {
          "const": true
        },
        "budget_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "used_tokens": {
          "$ref": "#/$defs/count"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "truncated": {
          "type": "boolean"
        },
        "omitted_files": {
          "$ref": "#/$defs/strings"
        },
        "downgraded_files": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "deep",
              "slim",
              "summary"
            ]
          }
        },
        "bounds": {
          "type": "object",
          "properties": {
            "files": {
              "$ref": "#/$defs/collection_bound"
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "$ref": "#/$defs/strings"
        },
        "graphs": {
          "type": "object"
        },
        "surface": {
          "type": "object"
        },
        "knowledge": {
          "$ref": "#/$defs/knowledge_response"
        },
        "typed_graph": {
          "type": "object"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "priority": {
                "$ref": "#/$defs/priority"
              }
            },
            "required": [
              "priority"
            ]
          }
        },
        "content": {
          "type": "string"
        },
        "prefer_fresh": {
          "const": true
        },
        "ranking_policy": {
          "type": "object"
        },
        "source_priorities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/priority"
          }
        }
      },
      "required": [
        "bounds",
        "budget_tokens",
        "downgraded_files",
        "filters",
        "focus",
        "format",
        "knowledge",
        "ok",
        "omitted_files",
        "protocol",
        "truncated",
        "used_tokens"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            }
          },
          "then": {
            "required": [
              "files"
            ],
            "not": {
              "required": [
                "content"
              ]
            }
          },
          "else": {
            "required": [
              "content"
            ],
            "not": {
              "required": [
                "files"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "prefer_fresh"
            ]
          },
          "then": {
            "required": [
              "ranking_policy"
            ]
          },
          "else": {
            "not": {
              "required": [
                "ranking_policy"
              ]
            }
          }
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "embedded_context": {
      "description": "The llm-wiki-context/v2 JSON response the envelope carries. Its budget_tokens is the internal allocation bound, not the requested budget.",
      "allOf": [
        {
          "$ref": "#/$defs/context_v2"
        },
        {
          "properties": {
            "format": {
              "const": "json"
            }
          },
          "required": [
            "source_priorities"
          ]
        }
      ]
    },
    "error": {
      "if": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/invalid_request"
      },
      "else": {
        "$ref": "#/$defs/cannot_fit"
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "language": {
          "$ref": "#/$defs/text"
        },
        "module": {
          "$ref": "#/$defs/text"
        },
        "symbol": {
          "$ref": "#/$defs/text"
        },
        "entrypoint": {
          "$ref": "#/$defs/text"
        },
        "surface": {
          "$ref": "#/$defs/text"
        },
        "relationship_kind": {
          "$ref": "#/$defs/text"
        },
        "freshness": {
          "enum": [
            "basis-incompatible",
            "current",
            "nonsemantic-source-change",
            "source-changed",
            "source-missing",
            "unknown"
          ]
        },
        "evidence": {
          "enum": [
            "invalid",
            "missing",
            "not-applicable",
            "present",
            "unknown"
          ]
        },
        "relationship_origin": {
          "enum": [
            "extracted",
            "governance",
            "inferred",
            "markdown"
          ]
        },
        "relationship_resolution": {
          "enum": [
            "ambiguous",
            "external",
            "resolved",
            "unresolved"
          ]
        },
        "relationship_direction": {
          "enum": [
            "both",
            "incoming",
            "outgoing"
          ]
        }
      },
      "additionalProperties": false
    },
    "focus": {
      "enum": [
        [
          "all"
        ],
        [
          "changed"
        ],
        [
          "changed",
          "neighbors"
        ]
      ]
    },
    "format": {
      "enum": [
        "json",
        "markdown"
      ]
    },
    "invalid_request": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "llm-wiki-context/v3"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "const": "invalid_request"
            },
            "message": {
              "$ref": "#/$defs/text"
            },
            "field": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error",
        "ok",
        "protocol"
      ],
      "additionalProperties": false
    },
    "knowledge_response": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "auto",
            "required"
          ]
        },
        "status": {
          "enum": [
            "disabled",
            "selected",
            "fallback"
          ]
        },
        "availability": {
          "enum": [
            "not-evaluated",
            "ready",
            "absent",
            "degraded",
            "unsupported"
          ]
        },
        "reason": {
          "$ref": "#/$defs/code"
        },
        "selected": {
          "type": "boolean"
        },
        "freshness_evaluated": {
          "type": "boolean"
        },
        "bounds": {
          "type": "object"
        },
        "fallback": {
          "type": "object",
          "properties": {
            "used": {
              "type": "boolean"
            },
            "evidence": {
              "$ref": "#/$defs/strings"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "reason",
            "used"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "object"
        },
        "maintenance": {
          "type": "object"
        }
      },
      "required": [
        "availability",
        "bounds",
        "fallback",
        "freshness_evaluated",
        "mode",
        "reason",
        "selected",
        "status"
      ],
      "additionalProperties": false
    },
    "markdown_metadata": {
      "description": "Everything the Markdown body renders except the source entries themselves.",
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "#/$defs/count"
        },
        "used": {
          "$ref": "#/$defs/count"
        },
        "bounds": {
          "type": "object",
          "properties": {
            "files": {
              "$ref": "#/$defs/collection_bound"
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "downgraded_files": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "deep",
              "slim",
              "summary"
            ]
          }
        },
        "graphs": {
          "type": "object"
        },
        "knowledge": {
          "$ref": "#/$defs/knowledge_response"
        },
        "omitted_files": {
          "$ref": "#/$defs/strings"
        },
        "ranking_policy": {
          "type": "object"
        },
        "source_priorities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/priority"
          }
        },
        "surface": {
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        },
        "typed_graph": {
          "type": "object"
        }
      },
      "required": [
        "bounds",
        "budget",
        "downgraded_files",
        "knowledge",
        "omitted_files",
        "source_priorities",
        "truncated",
        "used"
      ],
      "additionalProperties": false
    },
    "packet_v2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "llm-wiki-qualified-context-packet/v2"
        },
        "packet_id": {
          "$ref": "#/$defs/sha256"
        },
        "assurance": {
          "type": "object",
          "properties": {
            "level": {
              "const": "content-integrity"
            },
            "scope": {
              "const": "canonical-packet-content"
            }
          },
          "required": [
            "level",
            "scope"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "llm-wiki-context/v2"
            },
            "budget_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "$ref": "#/$defs/format"
            },
            "focus": {
              "$ref": "#/$defs/focus"
            },
            "filters": {
              "$ref": "#/$defs/filters"
            },
            "prefer_fresh": {
              "type": "boolean"
            },
            "knowledge_mode": {
              "enum": [
                "off",
                "auto",
                "required"
              ]
            }
          },
          "required": [
            "budget_tokens",
            "filters",
            "focus",
            "format",
            "knowledge_mode",
            "prefer_fresh",
            "protocol"
          ],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "llm-wiki-context/v2"
            },
            "ok": {
              "const": true
            },
            "budget_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "used_tokens": {
              "$ref": "#/$defs/count"
            },
            "format": {
              "$ref": "#/$defs/format"
            },
            "focus": {
              "$ref": "#/$defs/focus"
            },
            "filters": {
              "$ref": "#/$defs/filters"
            },
            "truncated": {
              "type": "boolean"
            },
            "omitted_files": {
              "$ref": "#/$defs/strings"
            },
            "downgraded_files": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "deep",
                  "slim",
                  "summary"
                ]
              }
            },
            "bounds": {
              "type": "object",
              "properties": {
                "files": {
                  "$ref": "#/$defs/collection_bound"
                }
              },
              "required": [
                "files"
              ],
              "additionalProperties": false
            },
            "warnings": {
              "$ref": "#/$defs/strings"
            },
            "graphs": {
              "type": "object"
            },
            "surface": {
              "type": "object"
            },
            "knowledge": {
              "$ref": "#/$defs/knowledge_response"
            },
            "typed_graph": {
              "type": "object"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "priority": {
                    "$ref": "#/$defs/priority"
                  }
                },
                "required": [
                  "priority"
                ]
              }
            },
            "content": {
              "type": "string"
            },
            "prefer_fresh": {
              "const": true
            },
            "ranking_policy": {
              "type": "object"
            },
            "source_priorities": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/priority"
              }
            }
          },
          "required": [
            "bounds",
            "budget_tokens",
            "downgraded_files",
            "filters",
            "focus",
            "format",
            "knowledge",
            "ok",
            "omitted_files",
            "protocol",
            "source_priorities",
            "truncated",
            "used_tokens"
          ],
          "additionalProperties": false
        },
        "basis": {
          "type": "object",
          "properties": {
            "source_snapshot": {
              "type": "object",
              "properties": {
                "identity": {
                  "$ref": "#/$defs/sha256"
                },
                "input_count": {
                  "$ref": "#/$defs/count"
                }
              },
              "required": [
                "identity",
                "input_count"
              ],
              "additionalProperties": false
            },
            "repository": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "unavailable"
                    },
                    "reason": {
                      "const": "native-knowledge-envelope-unavailable"
                    }
                  },
                  "required": [
                    "reason",
                    "state"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "recorded"
                    },
                    "identity": {
                      "$ref": "#/$defs/text"
                    },
                    "evaluated_revision": {
                      "$ref": "#/$defs/text"
                    },
                    "working_tree": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "required": [
                    "evaluated_revision",
                    "identity",
                    "state",
                    "working_tree"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "knowledge": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        },
                        "availability": {
                          "const": "absent"
                        },
                        "reason": {
                          "enum": [
                            "knowledge-projection-not-present"
                          ]
                        }
                      },
                      "required": [
                        "availability",
                        "reason",
                        "state"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        },
                        "availability": {
                          "const": "degraded"
                        },
                        "reason": {
                          "enum": [
                            "governance-missing",
                            "knowledge-basis-incompatible",
                            "policy-selected-surface-only-fallback-after-invalid",
                            "policy-selected-surface-only-fallback-after-mixed-snapshot",
                            "surface-validation-failed"
                          ]
                        }
                      },
                      "required": [
                        "availability",
                        "reason",
                        "state"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "unavailable"
                        },
                        "availability": {
                          "const": "unsupported"
                        },
                        "reason": {
                          "enum": [
                            "knowledge-schema-version-unsupported",
                            "manifest-version-unsupported",
                            "surface-schema-version-unsupported"
                          ]
                        }
                      },
                      "required": [
                        "availability",
                        "reason",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "recorded"
                    },
                    "availability": {
                      "const": "ready"
                    },
                    "reason": {
                      "const": "all-projection-commitments-match"
                    },
                    "envelope_hash": {
                      "$ref": "#/$defs/sha256"
                    },
                    "knowledge_index_hash": {
                      "$ref": "#/$defs/sha256"
                    },
                    "surface_index_hash": {
                      "$ref": "#/$defs/sha256"
                    },
                    "governance_hash": {
                      "$ref": "#/$defs/sha256"
                    }
                  },
                  "required": [
                    "availability",
                    "envelope_hash",
