              "external_uri"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target_class": {
                "enum": [
                  "anchor",
                  "asset",
                  "malformed"
                ]
              }
            },
            "required": [
              "target_class"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "locator"
                  ]
                },
                {
                  "required": [
                    "canonical_path"
                  ]
                },
                {
                  "required": [
                    "source_path"
                  ]
                },
                {
                  "required": [
                    "external_uri"
                  ]
                }
              ]
            },
            "required": [
              "raw_target"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "locator"
          ]
        },
        {
          "required": [
            "canonical_path"
          ]
        },
        {
          "required": [
            "source_path"
          ]
        },
        {
          "required": [
            "external_uri"
          ]
        },
        {
