            },
            "required": [
              "target_class"
            ]
          },
          "then": {
            "required": [
              "source_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target_class": {
                "const": "external"
              }
            },
            "required": [
              "target_class"
            ]
          },
          "then": {
            "properties": {
              "external_uri": {
                "not": {
                  "pattern": "^[Mm][Aa][Ii][Ll][Tt][Oo]:"
                }
              }
            },
            "required": [
              "external_uri"
            ]
          }
        },
        {
          "if": {
