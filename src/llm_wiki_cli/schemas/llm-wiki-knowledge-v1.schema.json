          ],
          "format": "uri",
        "pattern": "^(?!.*\\s)(?!.*\\\\)(?!.*%(?![0-9A-Fa-f]{2}))(?!(?:[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp][Ss]?):(?!//))(?![A-Za-z][A-Za-z0-9+.-]*://(?:[^/?#@]*@)?(?:[:/?#]|$))(?![Ll][Ll][Mm]-[Ww][Ii][Kk][Ii]:)[A-Za-z][A-Za-z0-9+.-]*:[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*$"
        },
        "raw_target": {
          "type": "string",
          "description": "The lossless target spelling observed in source Markdown."
        },
        "normalized_target": {
          "type": "string",
          "description": "The collector's normalized target spelling, which may be empty for malformed input."
        },
        "label": {
          "type": "string",
          "description": "The lossless Markdown link or image label."
        },
        "location": {
          "$ref": "#/$defs/linkLocation"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "dependentRequired": {
        "raw_target": [
          "normalized_target",
          "label",
          "location"
        ],
        "normalized_target": [
          "raw_target",
          "label",
          "location"
        ],
        "label": [
          "raw_target",
          "normalized_target",
          "location"
        ],
        "location": [
          "raw_target",
          "normalized_target",
          "label"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target_class": {
                "const": "concept"
              }
            },
            "required": [
              "target_class"
            ]
          },
          "then": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "locator"
                    ]
                  },
                  {
                    "required": [
                      "canonical_path"
                    ]
                  },
                  {
                    "required": [
                      "raw_target"
                    ]
                  }
                ]
              },
