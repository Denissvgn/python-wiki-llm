{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-wiki:schema:knowledge-object:v1",
  "title": "Knowledge catalog or record shard",
  "description": "Compact UTF-8, at most 8 MiB, named by the SHA-256 of its exact bytes. Radix prefixes may compress single-child paths; records retain stable owner and record identities. Hashes establish integrity, not provenance or live freshness.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "collection",
        "prefix",
        "kind",
        "children"
      ],
      "properties": {
        "schema_version": {
          "const": "llm-wiki-knowledge-object/v1"
        },
        "collection": {
          "enum": [
            "concepts",
            "relationships",
            "edges",
            "sections",
            "extensions",
            "values",
            "lookup"
          ]
        },
        "prefix": {
          "type": "string",
          "pattern": "^[0-9a-f]{0,128}$"
        },
        "kind": {
          "const": "catalog"
        },
        "children": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[0-9a-f]$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/descriptor"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "collection",
        "prefix",
        "kind",
        "records",
        "owners"
      ],
      "properties": {
        "schema_version": {
          "const": "llm-wiki-knowledge-object/v1"
        },
        "collection": {
          "enum": [
            "concepts",
            "relationships",
            "edges",
            "sections",
            "extensions",
            "values",
            "lookup"
          ]
        },
        "prefix": {
          "type": "string",
          "pattern": "^[0-9a-f]{0,128}$"
        },
        "kind": {
          "const": "records"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "owners": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "descriptor": {
      "type": "object",
      "required": [
        "hash",
        "bytes",
        "count"
      ],
      "properties": {
        "hash": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "additionalProperties": false
    },
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "required": [
            "$value"
          ],
          "properties": {
            "$value": {
              "$ref": "#/$defs/hash"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$basis"
          ],
          "properties": {
            "$basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "$object"
          ],
          "properties": {
            "$object": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/value"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "$value",
                "$basis",
                "$object"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "owner",
        "id",
        "value"
      ],
      "properties": {
        "owner": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    }
  }
}
